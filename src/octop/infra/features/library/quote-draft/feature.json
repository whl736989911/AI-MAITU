{
  "id": "quote-draft",
  "version": 1,
  "label": { "zh": "报价单草稿", "en": "Quote draft" },
  "description": {
    "zh": "根据客户信息与报价明细起草一封可直接发送的报价单",
    "en": "Draft a ready-to-send quotation from customer details and line items"
  },
  "icon_name": "receipt",
  "color": "#e5484d",
  "unit": "sales",
  "input_schema": {
    "type": "object",
    "required": ["customer_name", "currency", "valid_until", "line_items"],
    "properties": {
      "customer_name": {
        "type": "string",
        "title": { "zh": "客户名称", "en": "Customer" },
        "description": { "zh": "对方公司全称或联系人称呼", "en": "Company name or contact you address" }
      },
      "contact_email": {
        "type": "string",
        "format": "email",
        "title": { "zh": "对接邮箱", "en": "Contact email" },
        "description": { "zh": "报价单发给谁", "en": "Where the quote is sent" }
      },
      "currency": {
        "type": "string",
        "enum": ["CNY", "USD", "EUR"],
        "title": { "zh": "报价币种", "en": "Currency" },
        "description": { "zh": "所有单价与合计都用这个币种", "en": "All prices and totals use this currency" }
      },
      "valid_until": {
        "type": "string",
        "format": "date",
        "title": { "zh": "有效期至", "en": "Valid until" },
        "description": { "zh": "超过该日期报价失效", "en": "The quote lapses after this date" }
      },
      "line_items": {
        "type": "array",
        "title": { "zh": "报价明细", "en": "Line items" },
        "description": {
          "zh": "一行一项，每行三个单元格：名称 | 数量 | 单价",
          "en": "One row per item, three cells per row: name | quantity | unit price"
        },
        "items": { "type": "array", "items": { "type": "string" } }
      },
      "requirements": {
        "type": "string",
        "title": { "zh": "客户要求", "en": "Customer requirements" },
        "description": {
          "zh": "交期、付款方式、折扣或特别条款，可留空",
          "en": "Delivery, payment terms, discounts or special clauses; may be left empty"
        }
      }
    }
  },
  "ui_schema": {
    "order": [
      "customer_name",
      "contact_email",
      "currency",
      "valid_until",
      "line_items",
      "requirements"
    ],
    "widgets": { "requirements": "textarea" }
  },
  "prompt": {
    "system_file": "PROMPT.md",
    "user_template": "请根据下面的信息起草报价单草稿：\n\n{{inputs}}\n\n结构化输入（JSON）：\n{{inputs_json}}"
  },
  "output": { "kind": "markdown" },
  "permissions": { "allow_units": ["sales"], "allow_roles": ["member", "admin"] }
}
