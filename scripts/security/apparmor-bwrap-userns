# maitu: allow ONLY /usr/bin/bwrap to create user namespaces.
#
# Ubuntu 24.04+ restricts unprivileged user namespaces through AppArmor
# (kernel.apparmor_restrict_unprivileged_userns=1). Without this profile the
# platform sandbox fails with:
#   bwrap: setting up uid map: Permission denied
#
# This profile scopes the userns permission to the bubblewrap binary alone —
# it does NOT disable the restriction globally and grants nothing else.
#
# Install:  sudo bash scripts/setup-host-sandbox.sh
# Revert:   sudo bash scripts/setup-host-sandbox.sh --revert
# (scripts/setup-host-sandbox.sh automates both directions.)

abi <abi/4.0>,
include <tunables/global>

profile maitu-bwrap-userns /usr/bin/bwrap flags=(unconfined) {
  userns,
  include if exists <local/maitu-bwrap-userns>
}
